{
  "name": "@jalexw/invoice-hours-counter",
  "version": "0.2.4",
  "private": false,
  "repository": "https://github.com/jalexw/invoice-hours-counter.git",
  "license": "MIT",
  "scripts": {
    "cli": "bun run src/cli/index.ts",
    "test": "bun test",
    "build:cjs": "bun build ./src/cli/index.ts --outfile ./dist-cjs/cli.cjs --format cjs --target node",
    "build:esm": "bun build ./src/cli/index.ts --outfile ./dist-esm/cli.mjs --format esm --target node",
    "build:types": "tsc --project tsconfig.json",
    "build": "bun run build:types && bun run build:cjs && bun run build:esm",
    "web:dev": "next dev --port 3461",
    "web:build": "next build",
    "dev": "bun run web:dev"
  },
  "dependencies": {
    "@jalexw/calendar-ics-parser": "0.0.10",
    "next": "16.1.6",
    "@schemavaults/ui": "0.13.13",
    "lucide-react": "0.554.0",
    "zustand": "5.0.8"
  },
  "packageManager": "bun@1.3.6",
  "devDependencies": {
    "typescript": "5.9.3",
    "bun-types": "1.3.6",
    "tsc-alias": "1.8.16",
    "tailwindcss": "3.4.17",
    "@schemavaults/theme": "0.25.5",
    "postcss": "8.5.6",
    "autoprefixer": "10.4.17",
    "csv-parser": "3.2.0"
  },
  "type": "module",
  "module": "dist-esm/cli.mjs",
  "main": "dist-cjs/cli.cjs",
  "types": "dist-types/index.d.ts",
  "publishConfig": {
    "access": "public"
  }
}
